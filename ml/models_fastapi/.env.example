# Environment Variables — Agriculture ML API (Unified)
# Copy this file to .env and fill in your values.
# The server works with defaults — only override what you need.

# ── Inference device (Model 5 — EfficientNet-B0) ──────────────────────────
# DEVICE=cpu        (default — works everywhere)
# DEVICE=cuda       (GPU — requires compatible CUDA + PyTorch build)
DEVICE=cpu

# ── Logging ───────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO    (default)
# LOG_LEVEL=DEBUG   (verbose — logs every inference request)
LOG_LEVEL=INFO

# ── Model 3 V3 — Zero-Production Risk ─────────────────────────────────────
# THRESHOLD_APPLIES_TO controls whether zero_production_flag is decided
# against the calibrated or raw CatBoost probability.
# UNRESOLVED: must be verified against training/eval code (see model_3_api/README.md).
# Valid values: "calibrated" (default) | "raw"
THRESHOLD_APPLIES_TO=calibrated

# Set DEBUG_MODE=1 to include raw exception details in error responses
# (development only — never use in production).
DEBUG_MODE=0
