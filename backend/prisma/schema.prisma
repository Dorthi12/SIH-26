// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  LEADER
  ADMINISTRATOR
  REPRESENTATIVE
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Occupation {
  FARMER
  BUYER
  TRADER
  WHOLESALER
  EXPORTER
  OTHER
}

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  password        String?
  gender          String?         @default("Prefer not to say")
  phoneNumber     String?         @unique
  role            Role            @default(USER)
  dateOfBirth     DateTime?
  preSignedUrl  String          @default("https://netravaah-bucket.s3.ap-south-1.amazonaws.com/profile/default.png")
  refreshToken    String?
  department      String?
  occupation      Occupation? @default(FARMER)
  city            String?
  state           String?
  Position        String?
  themePreference ThemePreference @default(SYSTEM)
  authProvider    AuthProvider    @default(LOCAL)
  googleId        String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  posts           Post[]
  votes           Vote[]
  comments        Comment[]
  followers       Follow[]        @relation("UserFollowing")
  following       Follow[]        @relation("UserFollowers")
  issueReports    IssueReport[]   @relation("IssueReporter")
  assignedIssues  IssueReport[]   @relation("Assignee")
  conversations   Conversation[]
  complaints      Complaint[]

  // ML prediction history
  cropRecommendations CropRecommendation[]
  yieldPredictions    YieldPrediction[]
  diseasePredictions  DiseasePrediction[]
  zeroProductionRisks ZeroProductionRisk[]

  // Mandi module relations
  mandiCropListings  MandiCropListing[]
  mandiOffers        MandiOffer[]
  mandiDeals         MandiDeal[]
  buyerProfile       MandiBuyerProfile?
}

model Complaint{
  id                String   @id @default(uuid())
  title             String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          ComplaintCategory @default(OTHERS)
  description       String
  imageUrl          String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum ComplaintCategory {
  IRRIGATION
  CROP_STORAGE
  MARKET_MONOPOLY
  ORGANISED_CRIME
  PANCHAYAT_MISJUDGEMENT
  OTHERS
}

// ---------------------------------------------------------------------------
// ML Prediction Models
// ---------------------------------------------------------------------------

model CropRecommendation {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state           String
  district        String
  season          String
  topK            Int      @default(5)
  recommendations Json     // Full ML response stored as JSON
  modelName       String?
  modelVersion    String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model YieldPrediction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state           String
  district        String
  crop            String
  season          String
  cropYear        Int
  area            Float
  predictedYield  Float
  requestPayload  Json     // Full request sent to ML service
  responsePayload Json     // Full ML response
  modelName       String?
  modelVersion    String?
  warnings        String[]
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model DiseasePrediction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl        String?  // S3 URL of the uploaded image
  status          String   // "prediction" or "uncertain"
  crop            String?
  disease         String?
  isHealthy       Boolean?
  confidence      Float?
  responsePayload Json     // Full ML response
  modelName       String?
  modelVersion    String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model ZeroProductionRisk {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state                 String
  district              String
  crop                  String
  season                String
  area                  Float
  rawProbability        Float
  calibratedProbability Float
  zeroProductionFlag    Boolean
  riskLevel             String
  requestPayload        Json     // Request inputs stored as JSON
  responsePayload       Json     // Full response payload stored as JSON
  modelName             String?
  modelVersion          String?
  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model Post {
  id                String              @id @default(uuid())
  authorId          String
  author            User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption           String
  locationName      String?
  latitude          Float?
  longitude         Float?
  sentimentScore    Float?
  priorityScore     Float?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sentimentAnalysis SentimentAnalysis[]
  media             Media[]
  votes             Vote[]
  comments          Comment[]
  aianalyses        AIAnalysis[]
}

model SentimentAnalysis {
  id                   String         @id @default(uuid())
  postId               String
  post                 Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  text                 String?
  finalIssue           IssueCategory?
  confidence           Float?
  decidedBy            String?
  sentimentLabel       String?
  sentimentScore       Float?
  priorityScore        Float?
  wardNumber           String?
  assignedToDepartment String?
  locations            Json?
  textAnalysis         Json?
  imageAnalysis        Json?
  processedAt          DateTime?
  nlpProcessed         Boolean        @default(false)
  createdAt            DateTime       @default(now())

  @@index([postId])
  @@index([finalIssue])
  @@index([priorityScore])
}

model Media {
  id             String       @id @default(uuid())
  postId         String?
  post           Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  issueReportId  String?
  issueReport    IssueReport? @relation(fields: [issueReportId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  imageUrl       String?
  publicId       String
  type           MediaType
  createdAt      DateTime     @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}

model Vote {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  type      VoteType
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

model Comment {
  id         String       @id @default(uuid())
  postId     String
  authorId   String
  content    String
  parentId   String?
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id])
  parent     Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]    @relation("CommentReplies")
  createdAt  DateTime     @default(now())
  aianalyses AIAnalysis[]
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

enum AIContentType {
  POST
  ISSUE_REPORT
  COMMENT
}

enum AIModelType {
  SENTIMENT
  PRIORITY
  TOXICITY
  CATEGORY_CLASSIFICATION
  LANGUAGE_DETECTION
  DUPLICATE_DETECTION
  ENTITY_EXTRACTION
  MISINFORMATION_DETECTION
  DISEASE_DETECTION
}

enum IssueCategory {
  WATER_SUPPLY
  ROAD_DAMAGE
  ELECTRICITY
  STREET_LIGHTS
  DRAINAGE_AND_SEWAGE
  FLOODING
  GARBAGE_COLLECTION
  PUBLIC_TOILETS
  HEALTHCARE
  EDUCATION
  PUBLIC_SAFETY
  PUBLIC_TRANSPORT
  AIR_POLLUTION
  WATER_POLLUTION
  CORRUPTION
  GOVERNMENT_SCHEMES
  AGRICULTURE
  OTHERS
}

model AIAnalysis {
  id                String         @id @default(uuid())
  contentType       AIContentType
  modelType         AIModelType
  postId            String?
  post              Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  issueReportId     String?
  issueReport       IssueReport?   @relation(fields: [issueReportId], references: [id], onDelete: Cascade)
  commentId         String?
  comment           Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  sentiments        String[]
  sentimentScore    Float?
  priorityScore     Float?
  toxicityScore     Float?
  urgencyScore      Float?
  impactScore       Float?
  detectedLanguage  String?
  issueCategory     IssueCategory?
  issuePriority     IssuePriority?
  confidence        Float?
  extractedEntities Json?
  summary           String?
  diseaseResult     Json?
  modelName         String?
  modelVersion      String?
  processingTimeMs  Int?
  createdAt         DateTime       @default(now())

  @@index([contentType])
  @@index([modelType])
  @@index([postId])
  @@index([issueReportId])
}

enum IssueStatus {
  REPORTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model IssueReport {
  id            String        @id @default(uuid())
  reporterId    String
  reporter      User          @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  caption       String
  description   String?
  latitude      Float
  longitude     Float
  locationName  String?
  status        IssueStatus   @default(REPORTED)
  priority      IssuePriority @default(MEDIUM)
  viewCount     Int           @default(0)
  isDuplicate   Boolean       @default(false)
  duplicateOfId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  resolvedAt    DateTime?
  media         Media[]
  aiAnalysis    AIAnalysis[]
  assignedToId  String?
  assignedTo    User?         @relation("Assignee", fields: [assignedToId], references: [id])
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  title     String    @default("New Chat")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  media          Media[]
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ---------------------------------------------------------------------------
// Mandi Module Models
// ---------------------------------------------------------------------------

enum ListingGrade {
  GRADE_A
  GRADE_B
  STANDARD
}

enum OrganicStatus {
  VERIFIED_ORGANIC
  CLAIMED_ORGANIC
  CONVENTIONAL
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  DECLINED
}

enum DealPaymentState {
  PENDING
  PROTECTION_REQUESTED
  PAYMENT_PROTECTED
  AWAITING_DELIVERY
  DELIVERY_SUBMITTED
  DELIVERY_CONFIRMED
  PAYMENT_RELEASED
  DISPUTED
  CANCELLED
}

enum BuyerType {
  FOOD_PROCESSOR
  WHOLESALER
  EXPORTER
  RETAIL_CHAIN
  INSTITUTIONAL_BUYER
  PRIVATE_AGRO_CO
}

enum CropSeason {
  KHARIF
  RABI
  ZAID
  ALL_SEASON
}

// Master list of commodities with official MSP data
model Commodity {
  id              String   @id @default(uuid())
  name            String   // e.g. "Wheat", "Paddy", "Gram"
  variety         String?  // e.g. "HD-2967", "Pusa 1121"
  category        String   // e.g. "Cereal", "Pulse", "Oilseed", "Cash Crop"
  season          CropSeason @default(ALL_SEASON)
  mspPerQuintal   Float?   // Official MSP in ₹/quintal
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  mandiPrices     MandiPrice[]
  cropListings    MandiCropListing[]

  @@unique([name, variety])
  @@index([name])
  @@index([season])
}

// Reference APMC mandi markets across India
model MandiMarket {
  id        String   @id @default(uuid())
  name      String   // e.g. "Azadpur Mandi"
  state     String   // e.g. "Delhi"
  district  String   // e.g. "New Delhi"
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  prices MandiPrice[]

  @@unique([name, district, state])
  @@index([state])
  @@index([district])
}

// Daily commodity prices per mandi (seedable + future API integration)
model MandiPrice {
  id            String      @id @default(uuid())
  commodityId   String
  commodity     Commodity   @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  mandiId       String
  mandi         MandiMarket @relation(fields: [mandiId], references: [id], onDelete: Cascade)
  modalPrice    Float       // Most common trading price
  minPrice      Float
  maxPrice      Float
  arrivalTonnes Float?      // Quantity arrived at mandi
  arrivalDate   DateTime    // The date this price record is for
  createdAt     DateTime    @default(now())

  @@unique([commodityId, mandiId, arrivalDate])
  @@index([commodityId])
  @@index([mandiId])
  @@index([arrivalDate])
}

// Farmer crop listings for sale on the marketplace
model MandiCropListing {
  id                      String        @id @default(uuid())
  userId                  String
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  commodityId             String
  commodity               Commodity     @relation(fields: [commodityId], references: [id])
  variety                 String?
  quantityQuintals        Float
  askingPricePerQuintal   Float
  grade                   ListingGrade  @default(STANDARD)
  moisturePercentage      Float?
  organicStatus           OrganicStatus @default(CONVENTIONAL)
  organicCertificateNo    String?
  harvestDate             DateTime?
  productionMethod        String?       // e.g. "Conventional", "Natural Farming"
  productionCostPerQuintal Float?
  location                String        // e.g. "Barabanki, UP"
  locationState           String?
  locationDistrict        String?
  latitude                Float?
  longitude               Float?
  isActive                Boolean       @default(true)
  verifiedCrop            Boolean       @default(false)
  verifiedFarmer          Boolean       @default(false)
  evidenceStatus          Json?         // { organic, qualityReport, productionCost, harvestDate }
  fairPriceRange          Json?         // { min, max, breakdown }
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Relations
  offers MandiOffer[]

  @@index([userId])
  @@index([commodityId])
  @@index([isActive])
  @@index([createdAt])
}

// Buyer/company profiles (linked to User for role-based access)
model MandiBuyerProfile {
  id                      String    @id @default(uuid())
  userId                  String?   @unique
  user                    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                    String
  type                    BuyerType @default(WHOLESALER)
  location                String
  verified                Boolean   @default(false)
  completedTransactions   Int       @default(0)
  paymentReliabilityPct   Float     @default(0)
  avgPaymentDays          Float     @default(0)
  rating                  Float     @default(0)
  transparencyScore       Float     @default(0)
  activeDisputes          Int       @default(0)
  resolvedDisputes        Int       @default(0)
  reputationBreakdown     Json?     // { paymentReliability, priceFairness, behaviour, ... }
  purchaseCategories      String[]  // e.g. ["Wheat", "Rice", "Maize"]
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  offers MandiOffer[]
  deals  MandiDeal[]

  @@index([type])
  @@index([verified])
}

// Price negotiation offers between buyers and farmers
model MandiOffer {
  id                      String       @id @default(uuid())
  listingId               String
  listing                 MandiCropListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerProfileId          String
  buyerProfile            MandiBuyerProfile @relation(fields: [buyerProfileId], references: [id])
  userId                  String       // The farmer (listing owner)
  user                    User         @relation(fields: [userId], references: [id])
  crop                    String
  quantityQuintals        Float
  offeredPricePerQuintal  Float
  qualityCondition        String?
  moistureCondition       String?
  pickupType              String?      // "Buyer Pickup" | "Seller Delivery"
  deliveryDate            DateTime?
  paymentTermsDays        Int          @default(3)
  transportResponsibility String?      // "Buyer Pays" | "Seller Pays" | "Shared"
  status                  OfferStatus  @default(PENDING)
  negotiationHistory      Json?        // Array of { version, by, price, quantity, notes, timestamp }
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  // Relations
  deal MandiDeal?

  @@index([listingId])
  @@index([buyerProfileId])
  @@index([userId])
  @@index([status])
}

// Finalized smart deals
model MandiDeal {
  id                      String           @id @default(uuid())
  offerId                 String           @unique
  offer                   MandiOffer       @relation(fields: [offerId], references: [id])
  buyerProfileId          String
  buyerProfile            MandiBuyerProfile @relation(fields: [buyerProfileId], references: [id])
  userId                  String           // The farmer
  user                    User             @relation(fields: [userId], references: [id])
  crop                    String
  variety                 String?
  quantityQuintals        Float
  pricePerQuintal         Float
  totalValue              Float
  qualityGrade            String?
  moisturePercentage      Float?
  pickupLocation          String?
  deliveryDate            DateTime?
  paymentTerms            String?
  transportResponsibility String?
  buyerConfirmed          Boolean          @default(false)
  farmerConfirmed         Boolean          @default(false)
  termsLocked             Boolean          @default(false)
  paymentState            DealPaymentState @default(PENDING)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([buyerProfileId])
  @@index([userId])
  @@index([paymentState])
}
