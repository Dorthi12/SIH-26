# rag/.env.example — copy this to rag/.env and fill in your values
#
# The pipeline reads from environment variables (or this file via python-dotenv).
# Never commit rag/.env to git — it's in .gitignore.

# ──────────────────────────────────────────────
# Embedding Model
# ──────────────────────────────────────────────
# Multilingual model capable of English, Hindi, and Hinglish.
# Download happens automatically on first use (~120 MB).
# Other good options:
#   intfloat/multilingual-e5-small   (slightly smaller)
#   sentence-transformers/LaBSE     (best multilingual, ~1.8 GB)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ──────────────────────────────────────────────
# Pinecone
# ──────────────────────────────────────────────
# Get your API key from https://app.pinecone.io/
PINECONE_API_KEY=your-api-key-here

# Name of your Pinecone index.
# Create it in the Pinecone console with dimension=384 and metric=cosine
# before running the pipeline (or use the Pinecone SDK to create it).
PINECONE_INDEX_NAME=agrisense-govschemes

# Namespace within the index for government scheme documents.
# Using a namespace lets you isolate RAG data from other vectors in the same index.
PINECONE_NAMESPACE=government_schemes

# ──────────────────────────────────────────────
# Optional Tuning
# ──────────────────────────────────────────────
# EMBEDDING_BATCH_SIZE=64
# PINECONE_UPSERT_BATCH_SIZE=100
# CHUNK_TOKEN_SIZE=400
# CHUNK_OVERLAP_TOKENS=75
